# MongoDB Connection
# For local development, run: docker compose up -d
MONGODB_URI=mongodb://localhost:27017/ai-resume-analyzer
# For production (Render), set this to your MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/ai-resume-analyzer?retryWrites=true&w=majority

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_here

# Groq API Key (free tier available at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
